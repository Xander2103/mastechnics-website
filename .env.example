# ── Production deployment notes ──────────────────────────────────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://mastechnics.be   (required for correct canonical/sitemap URLs)
# LOG_LEVEL=error
# SESSION_SECURE_COOKIE=true   (requires HTTPS)
# SESSION_SAME_SITE=lax
# TRUSTED_PROXIES=            (leave empty on the Apache host: no reverse proxy.
#                              Only set the real proxy IP/CIDR list when a
#                              load balancer or CDN sits in front of PHP.)
# See "SESSION_HTTP_ONLY" below (already true by default).
#
# Mail (Brevo domain mastechnics.be is authenticated — use these in production):
# MAIL_FROM_ADDRESS=no-reply@mastechnics.be
# MAIL_FROM_NAME="Mastechnics"
#   Set MAIL_FROM_NAME to the literal string above — never ${APP_NAME} or
#   any other ${...} interpolation. A literal "${...}" value that fails to
#   interpolate (e.g. APP_NAME undefined, or config:cache baking in a stale
#   raw string) sends mail with that garbage text as the sender name.
# REQUEST_NOTIFICATION_EMAIL=martin@mastechnics.be
# ADMIN_NOTIFICATION_EMAIL=martin@mastechnics.be
# CONTACT_NOTIFICATION_EMAIL=martin@mastechnics.be
# ──────────────────────────────────────────────────────────────────────────

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@mastechnics.be"
MAIL_FROM_NAME="Mastechnics"

# Application-level upload limit for HVAC supplier imports (products +
# compatibility), in megabytes. The EFFECTIVE limit is the lowest of this
# value, PHP upload_max_filesize / post_max_size and the web server's body
# limit — see docs/hvac/import-deployment.md for the recommended server values.
HVAC_IMPORT_MAX_MB=25

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-* headers
# may be trusted. Empty = none (correct for a plain Apache host). Trusting
# "*" lets any client spoof its IP and bypass the form rate limits.
TRUSTED_PROXIES=

REQUEST_NOTIFICATION_EMAIL=martin@mastechnics.be
ADMIN_NOTIFICATION_EMAIL=
CONTACT_NOTIFICATION_EMAIL=martin@mastechnics.be
REQUEST_DAILY_LIMIT=5
REQUEST_BURST_LIMIT_PER_HOUR=10
CONTACT_DAILY_LIMIT=10
CONTACT_BURST_LIMIT_PER_HOUR=20

# TODO(Martin): required before launch for legal footer/quote compliance.
COMPANY_NUMBER=
COMPANY_ADDRESS=

# Local SEO. These feed the PostalAddress in the LocalBusiness structured data.
# Nothing is published until they are filled in — an incorrect NAP (name,
# address, phone) is worse for local ranking than no address at all, so leave
# them empty rather than guessing. They must match the Google Business Profile
# character for character.
COMPANY_LOCALITY=
COMPANY_POSTAL_CODE=
COMPANY_REGION="Vlaams-Brabant"

# Opening hours as published in the local panel. Pipe-separated schema.org
# openingHours strings, e.g. "Mo-Fr 08:00-17:00|Sa 09:00-12:00".
# Left empty means no openingHours is emitted at all, which is correct until
# the real hours are known.
COMPANY_OPENING_HOURS=

GOOGLE_REVIEWS_URL="https://www.google.com/search?q=Mas+Technics+Reviews"
TRUSTPILOT_REVIEWS_URL="https://nl.trustpilot.com/review/mastechnics.be"
FACEBOOK_URL="https://www.facebook.com/mastechnics"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin account for `php artisan db:seed` (AdminUserSeeder). Both are
# required in EVERY environment — the seeder refuses to plant a default
# password. Prefer `php artisan admin:create` on a live server.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Anti-spam on the public forms (docs/anti-spam.md) ────────────────────
# Bot challenge. Provider: turnstile (default, recommended) or recaptcha.
# REQUIRED in production: without the active provider's keys every public
# form submission is refused (fail closed) and an error is logged. Outside
# production the challenge is only active when the keys are set;
# CAPTCHA_ENABLED=true|false overrides that; an unrecognisable value counts
# as "not set" (never as off). Only APP_ENV local/testing/development may
# run without keys — any other value, including a typo, fails closed.
# Turnstile: Cloudflare dashboard -> Turnstile -> Add site, hostname
# mastechnics.be, widget mode "Managed".
CAPTCHA_PROVIDER=turnstile
# CAPTCHA_ENABLED=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Server-side Turnstile audit (sprint 21): the siteverify answer must carry
# the expected hostname (derived from APP_URL, plus this comma-separated
# list) and the expected action (contact|request). Mismatch = refused.
# CAPTCHA_EXPECTED_HOSTNAMES=mastechnics.be,www.mastechnics.be
# CAPTCHA_VERIFY_HOSTNAME=true
# CAPTCHA_VERIFY_ACTION=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Emergency kill switches (change + `php artisan config:clear`, no deploy).
CONTACT_FORM_ENABLED=true
REQUEST_WIZARD_ENABLED=true
# Customer confirmations are OFF by default (sprint 21): every confirmation
# is an external Brevo call a bot can provoke. Set true to send them again.
CUSTOMER_CONFIRMATION_MAIL_ENABLED=false

# Transactional mail budget (circuit breaker for the 300/day Brevo quota).
# A blocked mail never blocks the submission: it is stored, the skip is
# logged in mail_logs, nothing retries automatically.
MAIL_GUARD_ENABLED=true
# Joint circuit breaker (sprint 21): ALL form-related external mails
# (admin + customer, both forms) share one daily and one 10-minute counter.
# Once full: zero further Brevo calls from the public forms; submissions
# are still stored and visible in the admin.
FORM_EXTERNAL_MAIL_DAILY_LIMIT=20
FORM_EXTERNAL_MAIL_LIMIT_PER_10_MINUTES=4
CUSTOMER_CONFIRMATION_DAILY_LIMIT=100
ADMIN_NOTIFICATION_DAILY_LIMIT=150
FORM_MAIL_BURST_LIMIT=30

# Fill-time check: a submit faster than this many seconds after the form
# was rendered is refused; a token older than FORM_MAX_FILL_HOURS too.
FORM_MIN_FILL_SECONDS=3
FORM_MAX_FILL_HOURS=12

# Rate limits. Attempts = POSTs before validation (429 above the limit);
# the others count ACCEPTED submissions: per IP (day/hour), per normalized
# e-mail address per day, per form per day, and site-wide per 10 minutes.
CONTACT_ATTEMPT_LIMIT_PER_10_MINUTES=30
REQUEST_ATTEMPT_LIMIT_PER_10_MINUTES=30
GLOBAL_ATTEMPT_LIMIT_PER_10_MINUTES=120
CONTACT_DAILY_LIMIT=10
CONTACT_BURST_LIMIT_PER_HOUR=20
REQUEST_DAILY_LIMIT=5
REQUEST_BURST_LIMIT_PER_HOUR=10
CONTACT_EMAIL_DAILY_LIMIT=3
REQUEST_EMAIL_DAILY_LIMIT=3
CONTACT_GLOBAL_DAILY_LIMIT=60
REQUEST_GLOBAL_DAILY_LIMIT=60
FORM_ACCEPTED_BURST_LIMIT_PER_10_MINUTES=20
